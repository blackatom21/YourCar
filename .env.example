# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Ingestion worker + Q&A/cost bookkeeping. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Manual AI (Phase 2) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Optional overrides
# ANSWER_MODEL=claude-opus-5-5
# OCR_MODEL=claude-haiku-4-5
# EMBEDDING_MODEL=voyage-3.5     # must output 1024 dimensions
# RERANK_MODEL=rerank-2.5
# RAG_MIN_RERANK_SCORE=0.05

# --- Background jobs ---
# Production: set both (Inngest dashboard → your app → keys). The Vercel
# integration sets them for you.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# Local: leave unset to process manuals in-process ("inline"), or run
# `npx inngest-cli@latest dev` and set INNGEST_DEV=1.
# INGEST_RUNNER=inline

# Local UI work without API keys: deterministic fake AI providers.
# RAG_PROVIDERS=fake
